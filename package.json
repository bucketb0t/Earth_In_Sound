{
  "name": "earth-in-sound",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "database:setup": "tsx backend/database/scripts/run-database-setup.ts",
    "test": "npm run test:unit && npm run test:database && npm run test:e2e",
    "test:unit": "tsx tests/unit/test-unit.ts",
    "test:database": "tsx backend/database/scripts/test-database.ts",
    "test:e2e": "playwright test",
    "test:e2e:server": "tsx tests/e2e/start-test-server.ts",
    "verify": "npm run type-check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@libsql/kysely-libsql": "^0.4.1",
    "better-auth": "^1.7.4",
    "fast-xml-parser": "^5.8.0",
    "kysely": "0.28.17",
    "next": "16.3.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "overrides": {
    "kysely": "0.28.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
